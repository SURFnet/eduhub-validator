                :headers {"accept" "application/vnd.oeapi+json;version=6"}}]}

  {:match     [[:request, :method, "get"]
               [:response :status 200]
               [:response, :body, "items", ?i "buildingId" ?id]]
   :generates [{:method "get"
                :path   "/buildings/{?id}"
                :headers {"accept" "application/vnd.oeapi+json;version=6"}}
               {:method "get"
                :path   "/buildings/{?id}/rooms"
                :headers {"accept" "application/vnd.oeapi+json;version=6"}}]}

  {:match     [[:request, :method, "get"]
               [:response :status 200]
               [:response, :body, "items", ?i "courseId" ?id]]
   :generates [{:method "get"
                :path   "/courses/{?id}"
                :headers {"accept" "application/vnd.oeapi+json;version=6"}}
               {:method "get"
